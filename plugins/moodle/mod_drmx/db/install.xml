<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/drmx/db" VERSION="20260915" COMMENT="DRM-X protected video activities">
  <TABLES><TABLE NAME="drmx" COMMENT="Trusted activity to Content ID mapping">
    <FIELDS>
      <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
      <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT=""/>
      <FIELD NAME="intro" TYPE="text" NOTNULL="false"/>
      <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
      <FIELD NAME="contentid" TYPE="char" LENGTH="200" NOTNULL="true" DEFAULT=""/>
      <FIELD NAME="contenttype" TYPE="char" LENGTH="8" NOTNULL="true" DEFAULT="vod"/>
      <FIELD NAME="policy" TYPE="char" LENGTH="40" NOTNULL="true" DEFAULT=""/>
      <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
    </FIELDS>
    <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/></KEYS>
    <INDEXES><INDEX NAME="course_content" UNIQUE="false" FIELDS="course,contentid"/></INDEXES>
  </TABLE></TABLES>
</XMLDB>
